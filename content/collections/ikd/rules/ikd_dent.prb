        "feature_id": "hypophosphatemia",
        "source_attribute": "phen_hypophosphatemia",
        "section": "electrolytes_tubular",
        "question": "Has hypophosphataemia been documented on blood testing?",
        "answer_type": "presence",
        "hpo_id": "HP:0002148",
