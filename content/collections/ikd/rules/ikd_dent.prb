/* Dent disease: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_dent, {
    "description": "Dent disease candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "Dent disease",
        "disease_id": "ORPHA:1652",
        "source_refs": [
            "genereviews_dent"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "genereviews_dent"
            ],
            "weights": {
                "low_molecular_weight_proteinuria": 1,
                "hypercalciuria": 1,
                "nephrocalcinosis": 1,
                "calcium_nephrolithiasis": 1,
                "renal_phosphate_wasting": 1,
                "hypophosphatemia": 1,
                "renal_insufficiency": 1,
                "rickets": 1,
                "family_history_x_linked": 0
            }
        }
    }
});

low_molecular_weight_proteinuria => eadv.phen_low_molecular_weight_proteinuria.val.last();
hypercalciuria => eadv.phen_hypercalciuria.val.last();
nephrocalcinosis => eadv.phen_nephrocalcinosis.val.last();
calcium_nephrolithiasis => eadv.phen_calcium_nephrolithiasis.val.last();
renal_phosphate_wasting => eadv.phen_renal_phosphate_wasting.val.last();
hypophosphatemia => eadv.phen_hypophosphatemia.val.last();
renal_insufficiency => eadv.phen_renal_insufficiency.val.last();
rickets => eadv.phen_rickets.val.last();
family_history_x_linked => eadv.phen_family_history_x_linked.val.last();

present_feature_count : { . => coalesce(low_molecular_weight_proteinuria, 0) + coalesce(hypercalciuria, 0) + coalesce(nephrocalcinosis, 0) + coalesce(calcium_nephrolithiasis, 0) + coalesce(renal_phosphate_wasting, 0) + coalesce(hypophosphatemia, 0) + coalesce(renal_insufficiency, 0) + coalesce(rickets, 0) + coalesce(family_history_x_linked, 0) };
contribution_low_molecular_weight_proteinuria : { low_molecular_weight_proteinuria = 1 => 1 }, { => 0 };
contribution_hypercalciuria : { hypercalciuria = 1 => 1 }, { => 0 };
contribution_nephrocalcinosis : { nephrocalcinosis = 1 => 1 }, { => 0 };
contribution_calcium_nephrolithiasis : { calcium_nephrolithiasis = 1 => 1 }, { => 0 };
contribution_renal_phosphate_wasting : { renal_phosphate_wasting = 1 => 1 }, { => 0 };
contribution_hypophosphatemia : { hypophosphatemia = 1 => 1 }, { => 0 };
contribution_renal_insufficiency : { renal_insufficiency = 1 => 1 }, { => 0 };
contribution_rickets : { rickets = 1 => 1 }, { => 0 };
contribution_family_history_x_linked : { family_history_x_linked = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_low_molecular_weight_proteinuria + contribution_hypercalciuria + contribution_nephrocalcinosis + contribution_calcium_nephrolithiasis + contribution_renal_phosphate_wasting + contribution_hypophosphatemia + contribution_renal_insufficiency + contribution_rickets + contribution_family_history_x_linked };
[[rb_id]] : { . => weighted_score };

#define_attribute(low_molecular_weight_proteinuria, {
    "label": "Low-molecular-weight proteinuria",
    "atlas": {
        "role": "input",
        "feature_id": "low_molecular_weight_proteinuria",
        "source_attribute": "phen_low_molecular_weight_proteinuria",
        "section": "electrolytes_tubular",
        "question": "Has low-molecular-weight proteinuria been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0003126",
        "help": "Requires a documented tubular protein measurement or assessment; a routine positive protein dipstick or albuminuria alone is insufficient.",
        "source_refs": [
            "genereviews_dent",
            "hpo_terms_2026_09"
        ]
    }
});

#define_attribute(hypercalciuria, {
    "label": "High urinary calcium",
    "atlas": {
        "role": "input",
        "feature_id": "hypercalciuria",
        "source_attribute": "phen_hypercalciuria",
        "section": "electrolytes_tubular",
        "question": "Has high urinary calcium excretion been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0002150",
        "help": "Use urine measurements interpreted for age, collection method and treatment; this is not high blood calcium.",
        "source_refs": [
            "genereviews_dent",
            "hpo_terms_2026_09"
        ]
    }
});

#define_attribute(nephrocalcinosis, {
