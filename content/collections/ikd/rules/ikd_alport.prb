/* Candidate presence assessment: Alport syndrome. Source: Orphadata June 2026 snapshot.
   Inputs are Atlas questionnaire findings, not automatic EHR diagnoses.
   Research weights from the pinned LIRICAL extraction. Clinical calibration is pending. */
#define_ruleblock(ikd_alport, {
    "description": "Alport syndrome candidate assessment features",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.6.0-family-history",
        "scoring": {
            "model": "ikd-positive-log10-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "lirical_2020",
                "ikd_weights_2026_09"
            ],
            "weights": {
                "anterior_lenticonus": 2.787697,
                "bilateral_sensorineural_hearing_impairment": 2.218909,
                "glomerular_basement_membrane_lamellation": 3.220614,
                "microscopic_hematuria": 1.914155,
                "proteinuria": 1.582841,
                "retinal_flecks": 2.816185,
                "family_history_autosomal_dominant": 0,
                "family_history_autosomal_recessive": 0,
                "family_history_x_linked": 0
            }
        },
        "disease_label": "Alport syndrome",
        "disease_id": "ORPHA:63",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

microscopic_hematuria => eadv.phen_microscopic_hematuria.val.last();
proteinuria => eadv.phen_proteinuria.val.last();
bilateral_sensorineural_hearing_impairment => eadv.phen_bilateral_sensorineural_hearing_impairment.val.last();
anterior_lenticonus => eadv.phen_anterior_lenticonus.val.last();
retinal_flecks => eadv.phen_retinal_flecks.val.last();
glomerular_basement_membrane_lamellation => eadv.phen_glomerular_basement_membrane_lamellation.val.last();
family_history_autosomal_dominant => eadv.phen_family_history_autosomal_dominant.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();
family_history_x_linked => eadv.phen_family_history_x_linked.val.last();


/* Research phenotype matching: absent or unstated inputs contribute zero. */
present_feature_count : { . => coalesce(microscopic_hematuria, 0) + coalesce(proteinuria, 0) + coalesce(bilateral_sensorineural_hearing_impairment, 0) + coalesce(anterior_lenticonus, 0) + coalesce(retinal_flecks, 0) + coalesce(glomerular_basement_membrane_lamellation, 0) + coalesce(family_history_autosomal_dominant, 0) + coalesce(family_history_autosomal_recessive, 0) + coalesce(family_history_x_linked, 0) };
contribution_microscopic_hematuria : { microscopic_hematuria = 1 => 1.914155 }, { => 0 };
contribution_proteinuria : { proteinuria = 1 => 1.582841 }, { => 0 };
contribution_bilateral_sensorineural_hearing_impairment : { bilateral_sensorineural_hearing_impairment = 1 => 2.218909 }, { => 0 };
contribution_anterior_lenticonus : { anterior_lenticonus = 1 => 2.787697 }, { => 0 };
contribution_retinal_flecks : { retinal_flecks = 1 => 2.816185 }, { => 0 };
contribution_glomerular_basement_membrane_lamellation : { glomerular_basement_membrane_lamellation = 1 => 3.220614 }, { => 0 };
contribution_family_history_autosomal_dominant : { family_history_autosomal_dominant = 1 => 0 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
contribution_family_history_x_linked : { family_history_x_linked = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_microscopic_hematuria + contribution_proteinuria + contribution_bilateral_sensorineural_hearing_impairment + contribution_anterior_lenticonus + contribution_retinal_flecks + contribution_glomerular_basement_membrane_lamellation + contribution_family_history_autosomal_dominant + contribution_family_history_autosomal_recessive + contribution_family_history_x_linked };
[[rb_id]] : { . => weighted_score };

#define_attribute(microscopic_hematuria, {
    "label": "Microscopic haematuria",
    "atlas": {
        "role": "input",
        "feature_id": "microscopic_hematuria",
        "source_attribute": "phen_microscopic_hematuria",
        "section": "kidney",
        "question": "Has microscopic haematuria been documented on urine testing?",
        "answer_type": "presence",
        "hpo_id": "HP:0002907",
        "help": "Specifically documented microscopic haematuria.",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

