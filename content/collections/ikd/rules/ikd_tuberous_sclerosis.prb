/* Atlas IKD collection: five tuberous sclerosis complex-associated assessment features. */
#define_ruleblock(ikd_tuberous_sclerosis, {
    description: "Tuberous sclerosis complex assessment features",
    is_active: 2,
    atlas: {
        schema_version: "1",
        version: "0.6.0-family-history",
        scoring: {
            "model": "ikd-positive-log10-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "lirical_2020",
                "ikd_weights_2026_09"
            ],
            "weights": {
                "angiofibromas": 2.819881,
                "hypomelanotic_macule": 3.340975,
                "renal_angiomyolipoma": 2.650523,
                "seizure": 0.745661,
                "shagreen_patch": 3.162605,
                "family_history_autosomal_dominant": 0
            }
        },
        disease_label: "Tuberous sclerosis complex",
        disease_id: "ORPHA:805",
        source_refs: ["genereviews_tsc", "orphadata_2026_06"]
    }
});

hypomelanotic_macule => eadv.phen_hypomelanotic_macule.val.last();
angiofibromas => eadv.phen_angiofibromas.val.last();
shagreen_patch => eadv.phen_shagreen_patch.val.last();
renal_angiomyolipoma => eadv.phen_renal_angiomyolipoma.val.last();
seizure => eadv.phen_seizure.val.last();
family_history_autosomal_dominant => eadv.phen_family_history_autosomal_dominant.val.last();


/* Research phenotype matching: absent or unstated inputs contribute zero. */
present_feature_count : { . => coalesce(hypomelanotic_macule, 0) + coalesce(angiofibromas, 0) + coalesce(shagreen_patch, 0) + coalesce(renal_angiomyolipoma, 0) + coalesce(seizure, 0) + coalesce(family_history_autosomal_dominant, 0) };
contribution_hypomelanotic_macule : { hypomelanotic_macule = 1 => 3.340975 }, { => 0 };
contribution_angiofibromas : { angiofibromas = 1 => 2.819881 }, { => 0 };
contribution_shagreen_patch : { shagreen_patch = 1 => 3.162605 }, { => 0 };
contribution_renal_angiomyolipoma : { renal_angiomyolipoma = 1 => 2.650523 }, { => 0 };
contribution_seizure : { seizure = 1 => 0.745661 }, { => 0 };
contribution_family_history_autosomal_dominant : { family_history_autosomal_dominant = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_hypomelanotic_macule + contribution_angiofibromas + contribution_shagreen_patch + contribution_renal_angiomyolipoma + contribution_seizure + contribution_family_history_autosomal_dominant };
[[rb_id]] : { . => weighted_score };

#define_attribute(hypomelanotic_macule, {
    label: "Hypomelanotic macules",
    atlas: {
        role: "input",
        feature_id: "hypomelanotic_macule",
        source_attribute: "phen_hypomelanotic_macule",
        section: "skin_sweating",
        question: "Have hypomelanotic macules been identified?",
        answer_type: "presence",
        hpo_id: "HP:0009719",
        help: "Records identified patches of skin with reduced pigmentation. No lesion count is applied.",
        reference_image: {
            path: "/reference-images/tsc-skin-findings.png",
            alt: "Three-panel clinical image. the top panel shows pale hypomelanotic macules on the trunk and arms.",
            caption: "Top panel (A): hypomelanotic macules. The other panels show different TSC skin findings.",
            credit: "Portocarrero et al., Anais Brasileiros de Dermatologia (2018)",
            source_url: "https://commons.wikimedia.org/wiki/File:Hypopigmented_macules,_Shagreen_patch_and_periungual_fibroma_of_tuberous_sclerosis.png",
            license: "CC BY 4.0",
            license_url: "https://creativecommons.org/licenses/by/4.0/",
            sha256: "234f5ffc30708ab4b68d549e51884a9c0627ad415cf2207acc02fc69f30582c8",
            width: 993,
            height: 1935
        },
        source_refs: ["genereviews_tsc", "orphadata_2026_06"]
    }
});

#define_attribute(angiofibromas, {
    "label": "Angiofibromas",
    "atlas": {
