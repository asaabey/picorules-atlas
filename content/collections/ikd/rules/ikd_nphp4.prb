/* Nephronophthisis 4: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_nphp4, {
    "description": "Nephronophthisis 4 candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.7.0-ciliopathies",
        "disease_label": "Nephronophthisis 4",
        "disease_id": "OMIM:606966",
        "source_refs": [
            "hpoa_2026_09",
            "genereviews_nphp"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "genereviews_nphp"
            ],
            "weights": {
                "polyuria": 1,
                "polydipsia": 1,
                "anemia": 1,
                "growth_delay": 1,
                "renal_corticomedullary_cysts": 1,
                "renal_tubular_atrophy": 1,
                "stage_5_ckd": 1,
                "retinal_dystrophy": 1,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

polyuria => eadv.phen_polyuria.val.last();
polydipsia => eadv.phen_polydipsia.val.last();
anemia => eadv.phen_anemia.val.last();
growth_delay => eadv.phen_growth_delay.val.last();
renal_corticomedullary_cysts => eadv.phen_renal_corticomedullary_cysts.val.last();
renal_tubular_atrophy => eadv.phen_renal_tubular_atrophy.val.last();
stage_5_ckd => eadv.phen_stage_5_ckd.val.last();
retinal_dystrophy => eadv.phen_retinal_dystrophy.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(polyuria, 0) + coalesce(polydipsia, 0) + coalesce(anemia, 0) + coalesce(growth_delay, 0) + coalesce(renal_corticomedullary_cysts, 0) + coalesce(renal_tubular_atrophy, 0) + coalesce(stage_5_ckd, 0) + coalesce(retinal_dystrophy, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_polyuria : { polyuria = 1 => 1 }, { => 0 };
contribution_polydipsia : { polydipsia = 1 => 1 }, { => 0 };
contribution_anemia : { anemia = 1 => 1 }, { => 0 };
contribution_growth_delay : { growth_delay = 1 => 1 }, { => 0 };
contribution_renal_corticomedullary_cysts : { renal_corticomedullary_cysts = 1 => 1 }, { => 0 };
contribution_renal_tubular_atrophy : { renal_tubular_atrophy = 1 => 1 }, { => 0 };
contribution_stage_5_ckd : { stage_5_ckd = 1 => 1 }, { => 0 };
contribution_retinal_dystrophy : { retinal_dystrophy = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_polyuria + contribution_polydipsia + contribution_anemia + contribution_growth_delay + contribution_renal_corticomedullary_cysts + contribution_renal_tubular_atrophy + contribution_stage_5_ckd + contribution_retinal_dystrophy + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

