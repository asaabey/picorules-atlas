/* Candidate presence assessment: Von Hippel–Lindau disease. Source: Orphadata June 2026 snapshot.
   Inputs are Atlas questionnaire findings, not automatic EHR diagnoses.
   Research weights from the pinned LIRICAL extraction. Clinical calibration is pending. */
#define_ruleblock(ikd_vhl, {
    "description": "Von Hippel–Lindau disease candidate assessment features",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.6.0-family-history",
        "scoring": {
            "model": "ikd-positive-log10-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "lirical_2020",
                "ikd_weights_2026_09"
            ],
            "weights": {
                "adrenal_pheochromocytoma": 3.288922,
                "cerebellar_hemangioblastoma": 3.507856,
                "endolymphatic_sac_tumor": 3.30103,
                "multiple_renal_cysts": 2.226505,
                "pancreatic_endocrine_tumor": 2.604766,
                "renal_cell_carcinoma": 2.674507,
                "retinal_capillary_hemangioma": 3.382917,
                "family_history_autosomal_dominant": 0
            }
        },
        "disease_label": "Von Hippel–Lindau disease",
        "disease_id": "ORPHA:892",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

renal_cell_carcinoma => eadv.phen_renal_cell_carcinoma.val.last();
multiple_renal_cysts => eadv.phen_multiple_renal_cysts.val.last();
retinal_capillary_hemangioma => eadv.phen_retinal_capillary_hemangioma.val.last();
cerebellar_hemangioblastoma => eadv.phen_cerebellar_hemangioblastoma.val.last();
adrenal_pheochromocytoma => eadv.phen_adrenal_pheochromocytoma.val.last();
pancreatic_endocrine_tumor => eadv.phen_pancreatic_endocrine_tumor.val.last();
endolymphatic_sac_tumor => eadv.phen_endolymphatic_sac_tumor.val.last();
family_history_autosomal_dominant => eadv.phen_family_history_autosomal_dominant.val.last();


/* Research phenotype matching: absent or unstated inputs contribute zero. */
present_feature_count : { . => coalesce(renal_cell_carcinoma, 0) + coalesce(multiple_renal_cysts, 0) + coalesce(retinal_capillary_hemangioma, 0) + coalesce(cerebellar_hemangioblastoma, 0) + coalesce(adrenal_pheochromocytoma, 0) + coalesce(pancreatic_endocrine_tumor, 0) + coalesce(endolymphatic_sac_tumor, 0) + coalesce(family_history_autosomal_dominant, 0) };
contribution_renal_cell_carcinoma : { renal_cell_carcinoma = 1 => 2.674507 }, { => 0 };
contribution_multiple_renal_cysts : { multiple_renal_cysts = 1 => 2.226505 }, { => 0 };
contribution_retinal_capillary_hemangioma : { retinal_capillary_hemangioma = 1 => 3.382917 }, { => 0 };
contribution_cerebellar_hemangioblastoma : { cerebellar_hemangioblastoma = 1 => 3.507856 }, { => 0 };
contribution_adrenal_pheochromocytoma : { adrenal_pheochromocytoma = 1 => 3.288922 }, { => 0 };
contribution_pancreatic_endocrine_tumor : { pancreatic_endocrine_tumor = 1 => 2.604766 }, { => 0 };
contribution_endolymphatic_sac_tumor : { endolymphatic_sac_tumor = 1 => 3.30103 }, { => 0 };
contribution_family_history_autosomal_dominant : { family_history_autosomal_dominant = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_renal_cell_carcinoma + contribution_multiple_renal_cysts + contribution_retinal_capillary_hemangioma + contribution_cerebellar_hemangioblastoma + contribution_adrenal_pheochromocytoma + contribution_pancreatic_endocrine_tumor + contribution_endolymphatic_sac_tumor + contribution_family_history_autosomal_dominant };
[[rb_id]] : { . => weighted_score };

