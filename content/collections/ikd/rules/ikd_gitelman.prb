/* Gitelman syndrome: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_gitelman, {
    "description": "Gitelman syndrome candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "Gitelman syndrome",
        "disease_id": "ORPHA:358",
        "source_refs": [
            "erknet_gitelman"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "erknet_gitelman"
            ],
            "weights": {
                "hypokalemia": 1,
                "metabolic_alkalosis": 1,
                "hypomagnesemia": 1,
                "hypocalciuria": 1,
                "renal_salt_wasting": 1,
                "hypotension": 1,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

hypokalemia => eadv.phen_hypokalemia.val.last();
metabolic_alkalosis => eadv.phen_metabolic_alkalosis.val.last();
hypomagnesemia => eadv.phen_hypomagnesemia.val.last();
hypocalciuria => eadv.phen_hypocalciuria.val.last();
renal_salt_wasting => eadv.phen_renal_salt_wasting.val.last();
hypotension => eadv.phen_hypotension.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(hypokalemia, 0) + coalesce(metabolic_alkalosis, 0) + coalesce(hypomagnesemia, 0) + coalesce(hypocalciuria, 0) + coalesce(renal_salt_wasting, 0) + coalesce(hypotension, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_hypokalemia : { hypokalemia = 1 => 1 }, { => 0 };
contribution_metabolic_alkalosis : { metabolic_alkalosis = 1 => 1 }, { => 0 };
contribution_hypomagnesemia : { hypomagnesemia = 1 => 1 }, { => 0 };
contribution_hypocalciuria : { hypocalciuria = 1 => 1 }, { => 0 };
contribution_renal_salt_wasting : { renal_salt_wasting = 1 => 1 }, { => 0 };
contribution_hypotension : { hypotension = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_hypokalemia + contribution_metabolic_alkalosis + contribution_hypomagnesemia + contribution_hypocalciuria + contribution_renal_salt_wasting + contribution_hypotension + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

#define_attribute(hypokalemia, {
    "label": "Hypokalaemia",
    "atlas": {
        "role": "input",
        "feature_id": "hypokalemia",
        "source_attribute": "phen_hypokalemia",
        "section": "electrolytes_tubular",
        "question": "Has hypokalaemia been documented on blood testing?",
        "answer_type": "presence",
        "hpo_id": "HP:0002900",
        "help": "Use a documented laboratory finding interpreted for age and clinical context. A low or high blood concentration alone does not establish renal wasting or an inherited cause.",
        "source_refs": [
            "erknet_gitelman",
            "hpo_terms_2026_09"
        ]
    }
});

