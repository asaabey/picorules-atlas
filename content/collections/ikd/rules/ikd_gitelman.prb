    "atlas": {
        "role": "input",
        "feature_id": "renal_salt_wasting",
        "source_attribute": "phen_renal_salt_wasting",
        "section": "electrolytes_tubular",
        "question": "Has renal salt wasting been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0000127",
