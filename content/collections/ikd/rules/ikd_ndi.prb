/* Hereditary nephrogenic diabetes insipidus: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_ndi, {
    "description": "Hereditary nephrogenic diabetes insipidus candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "Hereditary nephrogenic diabetes insipidus",
        "disease_id": "ORPHA:223",
        "source_refs": [
            "genereviews_ndi"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "genereviews_ndi"
            ],
            "weights": {
                "polyuria": 1,
                "polydipsia": 1,
                "hyposthenuria": 1,
                "hypernatremia": 1,
                "dehydration": 1,
                "growth_delay": 1,
                "family_history_autosomal_dominant": 0,
                "family_history_autosomal_recessive": 0,
                "family_history_x_linked": 0
            }
        }
    }
});

polyuria => eadv.phen_polyuria.val.last();
polydipsia => eadv.phen_polydipsia.val.last();
hyposthenuria => eadv.phen_hyposthenuria.val.last();
hypernatremia => eadv.phen_hypernatremia.val.last();
dehydration => eadv.phen_dehydration.val.last();
growth_delay => eadv.phen_growth_delay.val.last();
family_history_autosomal_dominant => eadv.phen_family_history_autosomal_dominant.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();
family_history_x_linked => eadv.phen_family_history_x_linked.val.last();

present_feature_count : { . => coalesce(polyuria, 0) + coalesce(polydipsia, 0) + coalesce(hyposthenuria, 0) + coalesce(hypernatremia, 0) + coalesce(dehydration, 0) + coalesce(growth_delay, 0) + coalesce(family_history_autosomal_dominant, 0) + coalesce(family_history_autosomal_recessive, 0) + coalesce(family_history_x_linked, 0) };
contribution_polyuria : { polyuria = 1 => 1 }, { => 0 };
contribution_polydipsia : { polydipsia = 1 => 1 }, { => 0 };
contribution_hyposthenuria : { hyposthenuria = 1 => 1 }, { => 0 };
contribution_hypernatremia : { hypernatremia = 1 => 1 }, { => 0 };
contribution_dehydration : { dehydration = 1 => 1 }, { => 0 };
contribution_growth_delay : { growth_delay = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_dominant : { family_history_autosomal_dominant = 1 => 0 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
contribution_family_history_x_linked : { family_history_x_linked = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_polyuria + contribution_polydipsia + contribution_hyposthenuria + contribution_hypernatremia + contribution_dehydration + contribution_growth_delay + contribution_family_history_autosomal_dominant + contribution_family_history_autosomal_recessive + contribution_family_history_x_linked };
[[rb_id]] : { . => weighted_score };

#define_attribute(polyuria, {
    "label": "Polyuria",
    "atlas": {
        "role": "input",
        "feature_id": "polyuria",
        "source_attribute": "phen_polyuria",
        "section": "kidney",
        "question": "Has persistent excessive urine output been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0000103",
        "help": "Records the history or measured finding without setting a volume threshold.",
        "source_refs": [
            "genereviews_ndi"
        ]
    }
});

