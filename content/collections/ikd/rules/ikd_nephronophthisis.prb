/* Nephronophthisis, unspecified: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_nephronophthisis, {
    "description": "Nephronophthisis, unspecified candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.7.0-ciliopathies",
        "disease_label": "Nephronophthisis, unspecified",
        "disease_id": "ORPHA:655",
        "source_refs": [
            "orphadata_2026_06",
            "genereviews_nphp"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "genereviews_nphp"
            ],
            "weights": {
                "renal_insufficiency": 1,
                "anemia": 1,
                "abnormal_retinal_pigmentation": 1,
                "polyuria": 1,
                "polydipsia": 1,
                "renal_corticomedullary_cysts": 1,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

renal_insufficiency => eadv.phen_renal_insufficiency.val.last();
anemia => eadv.phen_anemia.val.last();
abnormal_retinal_pigmentation => eadv.phen_abnormal_retinal_pigmentation.val.last();
polyuria => eadv.phen_polyuria.val.last();
polydipsia => eadv.phen_polydipsia.val.last();
renal_corticomedullary_cysts => eadv.phen_renal_corticomedullary_cysts.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(renal_insufficiency, 0) + coalesce(anemia, 0) + coalesce(abnormal_retinal_pigmentation, 0) + coalesce(polyuria, 0) + coalesce(polydipsia, 0) + coalesce(renal_corticomedullary_cysts, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_renal_insufficiency : { renal_insufficiency = 1 => 1 }, { => 0 };
contribution_anemia : { anemia = 1 => 1 }, { => 0 };
contribution_abnormal_retinal_pigmentation : { abnormal_retinal_pigmentation = 1 => 1 }, { => 0 };
contribution_polyuria : { polyuria = 1 => 1 }, { => 0 };
contribution_polydipsia : { polydipsia = 1 => 1 }, { => 0 };
contribution_renal_corticomedullary_cysts : { renal_corticomedullary_cysts = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_renal_insufficiency + contribution_anemia + contribution_abnormal_retinal_pigmentation + contribution_polyuria + contribution_polydipsia + contribution_renal_corticomedullary_cysts + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

