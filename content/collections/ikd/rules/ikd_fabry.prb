/* Atlas IKD collection: five Fabry-associated assessment features. */
#define_ruleblock(ikd_fabry, {
    description: "Fabry disease assessment features",
    is_active: 2,
    atlas: {
        schema_version: "1",
        version: "0.6.0-family-history",
        scoring: {
            "model": "ikd-positive-log10-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "lirical_2020",
                "ikd_weights_2026_09"
            ],
            "weights": {
                "acroparesthesia": 3.033761,
                "angiokeratoma": 3.068523,
                "cornea_verticillata": 3.778151,
                "hypohidrosis": 2.122879,
                "proteinuria": 1.582841,
                "family_history_x_linked": 0
            }
        },
        disease_label: "Fabry disease",
        disease_id: "ORPHA:324",
        source_refs: ["genereviews_fabry", "orphadata_2026_06"]
    }
});

acroparesthesia => eadv.phen_acroparesthesia.val.last();
angiokeratoma => eadv.phen_angiokeratoma.val.last();
hypohidrosis => eadv.phen_hypohidrosis.val.last();
cornea_verticillata => eadv.phen_cornea_verticillata.val.last();
proteinuria => eadv.phen_proteinuria.val.last();
family_history_x_linked => eadv.phen_family_history_x_linked.val.last();


/* Research phenotype matching: absent or unstated inputs contribute zero. */
present_feature_count : { . => coalesce(acroparesthesia, 0) + coalesce(angiokeratoma, 0) + coalesce(hypohidrosis, 0) + coalesce(cornea_verticillata, 0) + coalesce(proteinuria, 0) + coalesce(family_history_x_linked, 0) };
contribution_acroparesthesia : { acroparesthesia = 1 => 3.033761 }, { => 0 };
contribution_angiokeratoma : { angiokeratoma = 1 => 3.068523 }, { => 0 };
contribution_hypohidrosis : { hypohidrosis = 1 => 2.122879 }, { => 0 };
contribution_cornea_verticillata : { cornea_verticillata = 1 => 3.778151 }, { => 0 };
contribution_proteinuria : { proteinuria = 1 => 1.582841 }, { => 0 };
contribution_family_history_x_linked : { family_history_x_linked = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_acroparesthesia + contribution_angiokeratoma + contribution_hypohidrosis + contribution_cornea_verticillata + contribution_proteinuria + contribution_family_history_x_linked };
[[rb_id]] : { . => weighted_score };

#define_attribute(acroparesthesia, {
    label: "Acroparaesthesia",
    atlas: {
        role: "input",
        feature_id: "acroparesthesia",
        source_attribute: "phen_acroparesthesia",
        section: "neurological_history",
        question: "Has the patient experienced episodes of burning or tingling pain in the hands or feet?",
        answer_type: "presence",
        hpo_id: "HP:0031006",
        help: "Episodes of pain or abnormal sensation in the extremities.",
        source_refs: ["genereviews_fabry", "orphadata_2026_06"]
    }
});

#define_attribute(angiokeratoma, {
    label: "Angiokeratomas",
    atlas: {
        role: "input",
        feature_id: "angiokeratoma",
        source_attribute: "phen_angiokeratoma",
        section: "skin_sweating",
        question: "Have angiokeratomas been identified?",
        answer_type: "presence",
        hpo_id: "HP:0001014",
        help: "Records whether these vascular skin lesions have been identified.",
        reference_image: {
            path: "/reference-images/fabry-angiokeratomas.jpg",
            alt: "Two clinical photographs showing red-purple angiokeratomas near the navel and on the oral mucosa.",
            caption: "Examples of Fabry-associated angiokeratomas near the navel and on the oral mucosa.",
            credit: "Burlina et al., BMC Neurology (2011)",
            source_url: "https://commons.wikimedia.org/wiki/File:Morbus_Fabry_Angiokeratoma_01.jpg",
            license: "CC BY 2.0",
            license_url: "https://creativecommons.org/licenses/by/2.0/",
            sha256: "93d2a3bd16121c60ae815c992f6cbc795abd33397839c52b45af6e149be61d00",
            width: 1200,
            height: 419
        },
        source_refs: ["genereviews_fabry", "orphadata_2026_06"]
    }
});

#define_attribute(hypohidrosis, {
    label: "Reduced sweating",
    atlas: {
        role: "input",
        feature_id: "hypohidrosis",
        source_attribute: "phen_hypohidrosis",
        section: "skin_sweating",
        question: "Does the patient report reduced sweating?",
        answer_type: "presence",
        hpo_id: "HP:0000966",
        help: "Records a history of sweating less than expected.",
        source_refs: ["genereviews_fabry", "orphadata_2026_06"]
    }
});

#define_attribute(cornea_verticillata, {
    label: "Cornea verticillata",
    atlas: {
        role: "input",
        feature_id: "cornea_verticillata",
        source_attribute: "phen_cornea_verticillata",
        section: "eyes",
        question: "Has cornea verticillata been documented on eye examination?",
        answer_type: "presence",
        hpo_id: "HP:0500008",
        help: "Records a documented corneal finding. It does not ask the patient to identify it.",
        reference_image: {
            path: "/reference-images/fabry-cornea-verticillata.jpg",
            alt: "Slit-lamp photograph showing a faint whorl pattern in the cornea of a patient with Fabry disease.",
            caption: "Cornea verticillata seen on slit-lamp examination in Fabry disease.",
            credit: "Burlina et al., BMC Neurology (2011)",
            source_url: "https://commons.wikimedia.org/wiki/File:Morbus_Fabry_Cornea_verticillata_01.jpg",
            license: "CC BY 2.0",
            license_url: "https://creativecommons.org/licenses/by/2.0/",
            sha256: "845b4fb804ada470192274095556740d18d2f2b79dd6a356176548d25a0a3066",
            width: 1200,
            height: 719
        },
        source_refs: ["genereviews_fabry", "orphadata_2026_06"]
    }
});

#define_attribute(proteinuria, {
    label: "Proteinuria",
    atlas: {
        role: "input",
        feature_id: "proteinuria",
        source_attribute: "phen_proteinuria",
        section: "kidney",
        question: "Has proteinuria been documented?",
        answer_type: "presence",
        hpo_id: "HP:0000093",
        help: "Records documented protein in the urine without applying a quantitative threshold.",
        source_refs: ["genereviews_fabry", "orphadata_2026_06"]
    }
});

#define_attribute(family_history_x_linked, {
    "label": "Documented family history suggesting X-linked inheritance",
    "atlas": {
        "role": "input",
        "evidence_kind": "family_history",
        "feature_id": "family_history_x_linked",
        "source_attribute": "phen_family_history_x_linked",
        "section": "family_history",
        "question": "Does transmission among affected relatives in the documented family history suggest an X-linked pattern?",
        "answer_type": "presence",
        "hpo_id": "HP:0001417",
        "help": "Affected relatives through the maternal line or affected daughters of an affected father may suggest X-linked inheritance. There is no father-to-son transmission. Females can also be affected, and an unclear pedigree does not exclude it.",
        "source_refs": ["genereviews_fabry"]
    }
});
