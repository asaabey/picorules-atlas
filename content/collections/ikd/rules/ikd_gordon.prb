/* Gordon syndrome / pseudohypoaldosteronism type II: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_gordon, {
    "description": "Gordon syndrome / pseudohypoaldosteronism type II candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "Gordon syndrome / pseudohypoaldosteronism type II",
        "disease_id": "ORPHA:757",
        "source_refs": [
            "genereviews_gordon"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "genereviews_gordon"
            ],
            "weights": {
                "hyperkalemia": 1,
                "hyperchloremic_metabolic_acidosis": 1,
                "hypertension": 1,
                "decreased_renin": 1,
                "hypercalciuria": 1,
                "family_history_autosomal_dominant": 0,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

hyperkalemia => eadv.phen_hyperkalemia.val.last();
hyperchloremic_metabolic_acidosis => eadv.phen_hyperchloremic_metabolic_acidosis.val.last();
hypertension => eadv.phen_hypertension.val.last();
decreased_renin => eadv.phen_decreased_renin.val.last();
hypercalciuria => eadv.phen_hypercalciuria.val.last();
family_history_autosomal_dominant => eadv.phen_family_history_autosomal_dominant.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(hyperkalemia, 0) + coalesce(hyperchloremic_metabolic_acidosis, 0) + coalesce(hypertension, 0) + coalesce(decreased_renin, 0) + coalesce(hypercalciuria, 0) + coalesce(family_history_autosomal_dominant, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_hyperkalemia : { hyperkalemia = 1 => 1 }, { => 0 };
contribution_hyperchloremic_metabolic_acidosis : { hyperchloremic_metabolic_acidosis = 1 => 1 }, { => 0 };
contribution_hypertension : { hypertension = 1 => 1 }, { => 0 };
contribution_decreased_renin : { decreased_renin = 1 => 1 }, { => 0 };
contribution_hypercalciuria : { hypercalciuria = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_dominant : { family_history_autosomal_dominant = 1 => 0 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_hyperkalemia + contribution_hyperchloremic_metabolic_acidosis + contribution_hypertension + contribution_decreased_renin + contribution_hypercalciuria + contribution_family_history_autosomal_dominant + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

#define_attribute(hyperkalemia, {
    "label": "Hyperkalaemia",
    "atlas": {
        "role": "input",
        "feature_id": "hyperkalemia",
        "source_attribute": "phen_hyperkalemia",
        "section": "electrolytes_tubular",
        "question": "Has hyperkalaemia been documented on blood testing?",
        "answer_type": "presence",
        "hpo_id": "HP:0002153",
        "help": "Use a documented laboratory finding interpreted for age and clinical context. A low or high blood concentration alone does not establish renal wasting or an inherited cause.",
        "source_refs": [
            "genereviews_gordon",
            "hpo_terms_2026_09"
        ]
    }
});

