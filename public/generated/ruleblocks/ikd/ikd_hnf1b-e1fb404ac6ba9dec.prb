/* HNF1B-related disease: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_hnf1b, {
    "description": "HNF1B-related disease candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "HNF1B-related disease",
        "disease_id": "ORPHA:93111",
        "source_refs": [
            "orphadata_2026_06",
            "erknet_hnf1b"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "erknet_hnf1b"
            ],
            "weights": {
                "diabetes_mellitus": 1,
                "horseshoe_kidney": 1,
                "hyperuricemia": 1,
                "multicystic_kidney_dysplasia": 1,
                "pancreatic_aplasia_hypoplasia": 1,
                "renal_agenesis": 1,
                "family_history_autosomal_dominant": 0,
                "hypomagnesemia": 1,
                "renal_magnesium_wasting": 1,
                "renal_cysts": 1
            }
        }
    }
});

diabetes_mellitus => eadv.phen_diabetes_mellitus.val.last();
horseshoe_kidney => eadv.phen_horseshoe_kidney.val.last();
hyperuricemia => eadv.phen_hyperuricemia.val.last();
multicystic_kidney_dysplasia => eadv.phen_multicystic_kidney_dysplasia.val.last();
pancreatic_aplasia_hypoplasia => eadv.phen_pancreatic_aplasia_hypoplasia.val.last();
renal_agenesis => eadv.phen_renal_agenesis.val.last();
family_history_autosomal_dominant => eadv.phen_family_history_autosomal_dominant.val.last();
hypomagnesemia => eadv.phen_hypomagnesemia.val.last();
renal_magnesium_wasting => eadv.phen_renal_magnesium_wasting.val.last();
renal_cysts => eadv.phen_renal_cysts.val.last();

present_feature_count : { . => coalesce(diabetes_mellitus, 0) + coalesce(horseshoe_kidney, 0) + coalesce(hyperuricemia, 0) + coalesce(multicystic_kidney_dysplasia, 0) + coalesce(pancreatic_aplasia_hypoplasia, 0) + coalesce(renal_agenesis, 0) + coalesce(family_history_autosomal_dominant, 0) + coalesce(hypomagnesemia, 0) + coalesce(renal_magnesium_wasting, 0) + coalesce(renal_cysts, 0) };
contribution_diabetes_mellitus : { diabetes_mellitus = 1 => 1 }, { => 0 };
contribution_horseshoe_kidney : { horseshoe_kidney = 1 => 1 }, { => 0 };
contribution_hyperuricemia : { hyperuricemia = 1 => 1 }, { => 0 };
contribution_multicystic_kidney_dysplasia : { multicystic_kidney_dysplasia = 1 => 1 }, { => 0 };
contribution_pancreatic_aplasia_hypoplasia : { pancreatic_aplasia_hypoplasia = 1 => 1 }, { => 0 };
contribution_renal_agenesis : { renal_agenesis = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_dominant : { family_history_autosomal_dominant = 1 => 0 }, { => 0 };
contribution_hypomagnesemia : { hypomagnesemia = 1 => 1 }, { => 0 };
contribution_renal_magnesium_wasting : { renal_magnesium_wasting = 1 => 1 }, { => 0 };
contribution_renal_cysts : { renal_cysts = 1 => 1 }, { => 0 };
weighted_score : { . => contribution_diabetes_mellitus + contribution_horseshoe_kidney + contribution_hyperuricemia + contribution_multicystic_kidney_dysplasia + contribution_pancreatic_aplasia_hypoplasia + contribution_renal_agenesis + contribution_family_history_autosomal_dominant + contribution_hypomagnesemia + contribution_renal_magnesium_wasting + contribution_renal_cysts };
[[rb_id]] : { . => weighted_score };

