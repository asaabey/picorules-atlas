        "question": "Has rickets been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0002748",
        "help": "Use a documented clinical or radiological diagnosis; adult osteomalacia is a different finding.",
        "source_refs": [
            "genereviews_xlh",
            "hpo_terms_2026_09"
        ]
    }
});

