#define_attribute(recurrent_dental_abscesses, {
    "label": "Recurrent dental abscesses",
    "atlas": {
        "role": "input",
        "feature_id": "recurrent_dental_abscesses",
        "source_attribute": "phen_recurrent_dental_abscesses",
        "section": "skeletal",
        "question": "Have recurrent dental abscesses been documented?",
