/* Mainzer–Saldino syndrome: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_mainzer_saldino, {
    "description": "Mainzer–Saldino syndrome candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.7.0-ciliopathies",
        "disease_label": "Mainzer–Saldino syndrome",
        "disease_id": "ORPHA:140969",
        "source_refs": [
            "orphanet_mainzer"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "orphanet_mainzer"
            ],
            "weights": {
                "renal_insufficiency": 1,
                "retinal_dystrophy": 1,
                "cone_shaped_phalangeal_epiphyses": 1,
                "ataxia": 1,
                "short_stature": 1,
                "short_thorax": 1,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

renal_insufficiency => eadv.phen_renal_insufficiency.val.last();
retinal_dystrophy => eadv.phen_retinal_dystrophy.val.last();
cone_shaped_phalangeal_epiphyses => eadv.phen_cone_shaped_phalangeal_epiphyses.val.last();
ataxia => eadv.phen_ataxia.val.last();
short_stature => eadv.phen_short_stature.val.last();
short_thorax => eadv.phen_short_thorax.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(renal_insufficiency, 0) + coalesce(retinal_dystrophy, 0) + coalesce(cone_shaped_phalangeal_epiphyses, 0) + coalesce(ataxia, 0) + coalesce(short_stature, 0) + coalesce(short_thorax, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_renal_insufficiency : { renal_insufficiency = 1 => 1 }, { => 0 };
contribution_retinal_dystrophy : { retinal_dystrophy = 1 => 1 }, { => 0 };
contribution_cone_shaped_phalangeal_epiphyses : { cone_shaped_phalangeal_epiphyses = 1 => 1 }, { => 0 };
contribution_ataxia : { ataxia = 1 => 1 }, { => 0 };
contribution_short_stature : { short_stature = 1 => 1 }, { => 0 };
contribution_short_thorax : { short_thorax = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_renal_insufficiency + contribution_retinal_dystrophy + contribution_cone_shaped_phalangeal_epiphyses + contribution_ataxia + contribution_short_stature + contribution_short_thorax + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

#define_attribute(renal_insufficiency, {
    "label": "Reduced kidney function",
    "atlas": {
        "role": "input",
        "feature_id": "renal_insufficiency",
        "source_attribute": "phen_renal_insufficiency",
        "section": "kidney",
        "question": "Has reduced kidney function been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0000083",
        "help": "Records an existing finding without assigning a cause or a new laboratory threshold.",
        "source_refs": [
            "orphanet_mainzer"
        ]
    }
});

