/* Familial hypomagnesaemia with hypercalciuria and nephrocalcinosis: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_fhhnc, {
    "description": "Familial hypomagnesaemia with hypercalciuria and nephrocalcinosis candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "Familial hypomagnesaemia with hypercalciuria and nephrocalcinosis",
        "disease_id": "ORPHA:306516",
        "source_refs": [
            "fhhnc_cohort"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "fhhnc_cohort"
            ],
            "weights": {
                "hypomagnesemia": 1,
                "renal_magnesium_wasting": 1,
                "hypercalciuria": 1,
                "nephrocalcinosis": 1,
                "renal_insufficiency": 1,
                "visual_impairment": 1,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

hypomagnesemia => eadv.phen_hypomagnesemia.val.last();
renal_magnesium_wasting => eadv.phen_renal_magnesium_wasting.val.last();
hypercalciuria => eadv.phen_hypercalciuria.val.last();
nephrocalcinosis => eadv.phen_nephrocalcinosis.val.last();
renal_insufficiency => eadv.phen_renal_insufficiency.val.last();
visual_impairment => eadv.phen_visual_impairment.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(hypomagnesemia, 0) + coalesce(renal_magnesium_wasting, 0) + coalesce(hypercalciuria, 0) + coalesce(nephrocalcinosis, 0) + coalesce(renal_insufficiency, 0) + coalesce(visual_impairment, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_hypomagnesemia : { hypomagnesemia = 1 => 1 }, { => 0 };
contribution_renal_magnesium_wasting : { renal_magnesium_wasting = 1 => 1 }, { => 0 };
contribution_hypercalciuria : { hypercalciuria = 1 => 1 }, { => 0 };
contribution_nephrocalcinosis : { nephrocalcinosis = 1 => 1 }, { => 0 };
contribution_renal_insufficiency : { renal_insufficiency = 1 => 1 }, { => 0 };
contribution_visual_impairment : { visual_impairment = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_hypomagnesemia + contribution_renal_magnesium_wasting + contribution_hypercalciuria + contribution_nephrocalcinosis + contribution_renal_insufficiency + contribution_visual_impairment + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

#define_attribute(hypomagnesemia, {
