[[rb_id]] : { . => weighted_score };

#define_attribute(glycosuria, {
    "label": "Glycosuria",
    "atlas": {
        "role": "input",
        "feature_id": "glycosuria",
        "source_attribute": "phen_glycosuria",
        "section": "electrolytes_tubular",
        "question": "Has glucose in the urine been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0003076",
        "help": "Record the urine finding. Proximal tubular interpretation requires blood glucose and medication context; this finding alone does not establish Fanconi syndrome.",
        "source_refs": [
            "genereviews_cystinosis",
            "hpo_terms_2026_09"
        ]
    }
});

