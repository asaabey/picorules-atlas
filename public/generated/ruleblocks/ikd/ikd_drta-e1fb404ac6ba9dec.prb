/* Inherited distal renal tubular acidosis: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_drta, {
    "description": "Inherited distal renal tubular acidosis candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "Inherited distal renal tubular acidosis",
        "disease_id": "ORPHA:18",
        "source_refs": [
            "genereviews_drta"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "genereviews_drta"
            ],
            "weights": {
                "hyperchloremic_metabolic_acidosis": 1,
                "hypokalemia": 1,
                "alkaline_urine": 1,
                "hypercalciuria": 1,
                "nephrocalcinosis": 1,
                "calcium_nephrolithiasis": 1,
                "growth_delay": 1,
                "rickets": 1,
                "bilateral_sensorineural_hearing_impairment": 1,
                "family_history_autosomal_dominant": 0,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

hyperchloremic_metabolic_acidosis => eadv.phen_hyperchloremic_metabolic_acidosis.val.last();
hypokalemia => eadv.phen_hypokalemia.val.last();
alkaline_urine => eadv.phen_alkaline_urine.val.last();
hypercalciuria => eadv.phen_hypercalciuria.val.last();
nephrocalcinosis => eadv.phen_nephrocalcinosis.val.last();
calcium_nephrolithiasis => eadv.phen_calcium_nephrolithiasis.val.last();
growth_delay => eadv.phen_growth_delay.val.last();
rickets => eadv.phen_rickets.val.last();
bilateral_sensorineural_hearing_impairment => eadv.phen_bilateral_sensorineural_hearing_impairment.val.last();
family_history_autosomal_dominant => eadv.phen_family_history_autosomal_dominant.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(hyperchloremic_metabolic_acidosis, 0) + coalesce(hypokalemia, 0) + coalesce(alkaline_urine, 0) + coalesce(hypercalciuria, 0) + coalesce(nephrocalcinosis, 0) + coalesce(calcium_nephrolithiasis, 0) + coalesce(growth_delay, 0) + coalesce(rickets, 0) + coalesce(bilateral_sensorineural_hearing_impairment, 0) + coalesce(family_history_autosomal_dominant, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_hyperchloremic_metabolic_acidosis : { hyperchloremic_metabolic_acidosis = 1 => 1 }, { => 0 };
contribution_hypokalemia : { hypokalemia = 1 => 1 }, { => 0 };
contribution_alkaline_urine : { alkaline_urine = 1 => 1 }, { => 0 };
contribution_hypercalciuria : { hypercalciuria = 1 => 1 }, { => 0 };
contribution_nephrocalcinosis : { nephrocalcinosis = 1 => 1 }, { => 0 };
contribution_calcium_nephrolithiasis : { calcium_nephrolithiasis = 1 => 1 }, { => 0 };
contribution_growth_delay : { growth_delay = 1 => 1 }, { => 0 };
contribution_rickets : { rickets = 1 => 1 }, { => 0 };
contribution_bilateral_sensorineural_hearing_impairment : { bilateral_sensorineural_hearing_impairment = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_dominant : { family_history_autosomal_dominant = 1 => 0 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_hyperchloremic_metabolic_acidosis + contribution_hypokalemia + contribution_alkaline_urine + contribution_hypercalciuria + contribution_nephrocalcinosis + contribution_calcium_nephrolithiasis + contribution_growth_delay + contribution_rickets + contribution_bilateral_sensorineural_hearing_impairment + contribution_family_history_autosomal_dominant + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

#define_attribute(hyperchloremic_metabolic_acidosis, {
    "label": "Hyperchloraemic metabolic acidosis",
    "atlas": {
        "role": "input",
        "feature_id": "hyperchloremic_metabolic_acidosis",
        "source_attribute": "phen_hyperchloremic_metabolic_acidosis",
        "section": "electrolytes_tubular",
        "question": "Has hyperchloraemic metabolic acidosis been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0004918",
        "help": "Requires the specific acid–base pattern, rather than low bicarbonate or high chloride alone.",
        "source_refs": [
            "genereviews_drta",
            "hpo_terms_2026_09"
        ]
    }
});

