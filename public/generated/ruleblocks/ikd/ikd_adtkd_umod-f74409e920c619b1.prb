#define_attribute(family_history_autosomal_dominant, {
    "label": "Documented family history suggesting autosomal dominant inheritance",
    "atlas": {
        "role": "input",
        "evidence_kind": "family_history",
        "feature_id": "family_history_autosomal_dominant",
        "source_attribute": "phen_family_history_autosomal_dominant",
        "section": "family_history",
        "question": "Does the documented family history show a similar condition in successive generations?",
        "answer_type": "presence",
        "hpo_id": "HP:0000006",
        "help": "A pattern in a parent and child or across successive generations may suggest dominant inheritance. A negative or unclear family history does not exclude disease.",
        "source_refs": ["genereviews_adtkd_umod"]
    }
});
