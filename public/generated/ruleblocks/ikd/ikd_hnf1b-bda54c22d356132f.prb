/* Candidate presence assessment: HNF1B-related disease. Source: Orphadata June 2026 snapshot.
   Inputs are Atlas questionnaire findings, not automatic EHR diagnoses.
   Research weights from the pinned LIRICAL extraction. Clinical calibration is pending. */
#define_ruleblock(ikd_hnf1b, {
    "description": "HNF1B-related disease candidate assessment features",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.6.0-family-history",
        "scoring": {
            "model": "ikd-positive-log10-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "lirical_2020",
                "ikd_weights_2026_09"
            ],
            "weights": {
                "diabetes_mellitus": 1.520433,
                "horseshoe_kidney": 1.702054,
                "hyperuricemia": 1.797077,
                "multicystic_kidney_dysplasia": 2.41361,
                "pancreatic_aplasia_hypoplasia": 2.315417,
                "renal_agenesis": 1.401984,
                "family_history_autosomal_dominant": 0
            }
        },
        "disease_label": "HNF1B-related disease",
        "disease_id": "ORPHA:93111",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

multicystic_kidney_dysplasia => eadv.phen_multicystic_kidney_dysplasia.val.last();
renal_agenesis => eadv.phen_renal_agenesis.val.last();
horseshoe_kidney => eadv.phen_horseshoe_kidney.val.last();
diabetes_mellitus => eadv.phen_diabetes_mellitus.val.last();
pancreatic_aplasia_hypoplasia => eadv.phen_pancreatic_aplasia_hypoplasia.val.last();
hyperuricemia => eadv.phen_hyperuricemia.val.last();
family_history_autosomal_dominant => eadv.phen_family_history_autosomal_dominant.val.last();


/* Research phenotype matching: absent or unstated inputs contribute zero. */
present_feature_count : { . => coalesce(multicystic_kidney_dysplasia, 0) + coalesce(renal_agenesis, 0) + coalesce(horseshoe_kidney, 0) + coalesce(diabetes_mellitus, 0) + coalesce(pancreatic_aplasia_hypoplasia, 0) + coalesce(hyperuricemia, 0) + coalesce(family_history_autosomal_dominant, 0) };
contribution_multicystic_kidney_dysplasia : { multicystic_kidney_dysplasia = 1 => 2.41361 }, { => 0 };
contribution_renal_agenesis : { renal_agenesis = 1 => 1.401984 }, { => 0 };
contribution_horseshoe_kidney : { horseshoe_kidney = 1 => 1.702054 }, { => 0 };
contribution_diabetes_mellitus : { diabetes_mellitus = 1 => 1.520433 }, { => 0 };
contribution_pancreatic_aplasia_hypoplasia : { pancreatic_aplasia_hypoplasia = 1 => 2.315417 }, { => 0 };
contribution_hyperuricemia : { hyperuricemia = 1 => 1.797077 }, { => 0 };
contribution_family_history_autosomal_dominant : { family_history_autosomal_dominant = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_multicystic_kidney_dysplasia + contribution_renal_agenesis + contribution_horseshoe_kidney + contribution_diabetes_mellitus + contribution_pancreatic_aplasia_hypoplasia + contribution_hyperuricemia + contribution_family_history_autosomal_dominant };
[[rb_id]] : { . => weighted_score };

#define_attribute(multicystic_kidney_dysplasia, {
    "label": "Multicystic kidney dysplasia",
    "atlas": {
        "role": "input",
        "feature_id": "multicystic_kidney_dysplasia",
        "source_attribute": "phen_multicystic_kidney_dysplasia",
        "section": "kidney",
        "question": "Has multicystic kidney dysplasia been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0000003",
        "help": "Records explicitly documented dysplasia. renal cysts alone do not establish this finding.",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

