/* Hereditary hypophosphataemic rickets with hypercalciuria: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_hhrh, {
    "description": "Hereditary hypophosphataemic rickets with hypercalciuria candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "Hereditary hypophosphataemic rickets with hypercalciuria",
        "disease_id": "ORPHA:157215",
        "source_refs": [
            "hhrh_original"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "hhrh_original"
            ],
            "weights": {
                "renal_phosphate_wasting": 1,
                "hypophosphatemia": 1,
                "hypercalciuria": 1,
                "elevated_calcitriol": 1,
                "rickets": 1,
                "short_stature": 1,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

renal_phosphate_wasting => eadv.phen_renal_phosphate_wasting.val.last();
hypophosphatemia => eadv.phen_hypophosphatemia.val.last();
hypercalciuria => eadv.phen_hypercalciuria.val.last();
elevated_calcitriol => eadv.phen_elevated_calcitriol.val.last();
rickets => eadv.phen_rickets.val.last();
short_stature => eadv.phen_short_stature.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(renal_phosphate_wasting, 0) + coalesce(hypophosphatemia, 0) + coalesce(hypercalciuria, 0) + coalesce(elevated_calcitriol, 0) + coalesce(rickets, 0) + coalesce(short_stature, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_renal_phosphate_wasting : { renal_phosphate_wasting = 1 => 1 }, { => 0 };
contribution_hypophosphatemia : { hypophosphatemia = 1 => 1 }, { => 0 };
contribution_hypercalciuria : { hypercalciuria = 1 => 1 }, { => 0 };
contribution_elevated_calcitriol : { elevated_calcitriol = 1 => 1 }, { => 0 };
contribution_rickets : { rickets = 1 => 1 }, { => 0 };
contribution_short_stature : { short_stature = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_renal_phosphate_wasting + contribution_hypophosphatemia + contribution_hypercalciuria + contribution_elevated_calcitriol + contribution_rickets + contribution_short_stature + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

#define_attribute(renal_phosphate_wasting, {
