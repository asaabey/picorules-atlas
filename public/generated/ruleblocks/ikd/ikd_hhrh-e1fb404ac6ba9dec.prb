    "atlas": {
        "role": "input",
        "feature_id": "renal_phosphate_wasting",
        "source_attribute": "phen_renal_phosphate_wasting",
        "section": "electrolytes_tubular",
        "question": "Has inappropriate renal phosphate loss been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0000117",
        "help": "Requires a documented renal phosphate-handling assessment; low blood phosphate alone is insufficient.",
        "source_refs": [
