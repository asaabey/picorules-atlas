            "orphadata_2026_06"
        ]
    }
});

#define_attribute(oligohydramnios, {
    "label": "Oligohydramnios in the patient’s prenatal history",
    "atlas": {
        "role": "input",
        "feature_id": "oligohydramnios",
        "source_attribute": "phen_oligohydramnios",
        "section": "liver_pregnancy",
        "question": "Was oligohydramnios documented during the pregnancy in which this patient was carried?",
        "answer_type": "presence",
        "hpo_id": "HP:0001562",
        "help": "Refers to the patient’s own prenatal history, not a later pregnancy carried by the patient. Unknown if records are unavailable.",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

#define_attribute(hypertension, {
    "label": "Hypertension",
    "atlas": {
        "role": "input",
        "feature_id": "hypertension",
        "source_attribute": "phen_hypertension",
        "section": "cardiovascular",
