/* Candidate presence assessment: Autosomal recessive polycystic kidney disease. Source: Orphadata June 2026 snapshot.
   Inputs are Atlas questionnaire findings, not automatic EHR diagnoses.
   Research weights from the pinned LIRICAL extraction. Clinical calibration is pending. */
#define_ruleblock(ikd_arpkd, {
    "description": "Autosomal recessive polycystic kidney disease candidate assessment features",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.6.0-family-history",
        "scoring": {
            "model": "ikd-positive-log10-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "lirical_2020",
                "ikd_weights_2026_09"
            ],
            "weights": {
                "congenital_hepatic_fibrosis": 2.965515,
                "enlarged_kidney": 2.497345,
                "hypertension": 1.581553,
                "oligohydramnios": 1.848822,
                "polycystic_kidney_dysplasia": 2.417793,
                "portal_hypertension": 2.316049,
                "family_history_autosomal_recessive": 0
            }
        },
        "disease_label": "Autosomal recessive polycystic kidney disease",
        "disease_id": "ORPHA:731",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

enlarged_kidney => eadv.phen_enlarged_kidney.val.last();
polycystic_kidney_dysplasia => eadv.phen_polycystic_kidney_dysplasia.val.last();
congenital_hepatic_fibrosis => eadv.phen_congenital_hepatic_fibrosis.val.last();
portal_hypertension => eadv.phen_portal_hypertension.val.last();
oligohydramnios => eadv.phen_oligohydramnios.val.last();
hypertension => eadv.phen_hypertension.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();


/* Research phenotype matching: absent or unstated inputs contribute zero. */
present_feature_count : { . => coalesce(enlarged_kidney, 0) + coalesce(polycystic_kidney_dysplasia, 0) + coalesce(congenital_hepatic_fibrosis, 0) + coalesce(portal_hypertension, 0) + coalesce(oligohydramnios, 0) + coalesce(hypertension, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_enlarged_kidney : { enlarged_kidney = 1 => 2.497345 }, { => 0 };
contribution_polycystic_kidney_dysplasia : { polycystic_kidney_dysplasia = 1 => 2.417793 }, { => 0 };
contribution_congenital_hepatic_fibrosis : { congenital_hepatic_fibrosis = 1 => 2.965515 }, { => 0 };
contribution_portal_hypertension : { portal_hypertension = 1 => 2.316049 }, { => 0 };
contribution_oligohydramnios : { oligohydramnios = 1 => 1.848822 }, { => 0 };
contribution_hypertension : { hypertension = 1 => 1.581553 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_enlarged_kidney + contribution_polycystic_kidney_dysplasia + contribution_congenital_hepatic_fibrosis + contribution_portal_hypertension + contribution_oligohydramnios + contribution_hypertension + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

#define_attribute(enlarged_kidney, {
    "label": "Enlarged kidney",
    "atlas": {
        "role": "input",
        "feature_id": "enlarged_kidney",
        "source_attribute": "phen_enlarged_kidney",
        "section": "kidney",
        "question": "Has kidney enlargement been documented on imaging?",
        "answer_type": "presence",
        "hpo_id": "HP:0000105",
        "help": "Records documented kidney enlargement without applying a size threshold.",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

#define_attribute(polycystic_kidney_dysplasia, {
    "label": "Polycystic kidney dysplasia",
    "atlas": {
        "role": "input",
        "feature_id": "polycystic_kidney_dysplasia",
        "source_attribute": "phen_polycystic_kidney_dysplasia",
        "section": "kidney",
        "question": "Has polycystic kidney dysplasia been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0000113",
        "help": "Requires the named structural finding. multiple renal cysts alone are insufficient.",
        "source_refs": [
            "orphadata_2026_06"
        ]
    }
});

#define_attribute(congenital_hepatic_fibrosis, {
