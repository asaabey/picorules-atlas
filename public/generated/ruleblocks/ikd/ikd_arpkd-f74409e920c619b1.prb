        "question": "Has congenital hepatic fibrosis been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0002612",
        "help": "Records congenital hepatic fibrosis. unspecified liver fibrosis does not establish this subtype.",
        "source_refs": [
