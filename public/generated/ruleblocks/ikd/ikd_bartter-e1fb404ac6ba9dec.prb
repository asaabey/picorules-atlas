/* Bartter syndrome: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_bartter, {
    "description": "Bartter syndrome candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.8.0-tubulopathies",
        "disease_label": "Bartter syndrome",
        "disease_id": "ORPHA:112",
        "source_refs": [
            "erknet_bartter"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "erknet_bartter"
            ],
            "weights": {
                "hypokalemia": 1,
                "metabolic_alkalosis": 1,
                "renal_salt_wasting": 1,
                "hypercalciuria": 1,
                "nephrocalcinosis": 1,
                "polyuria": 1,
                "polydipsia": 1,
                "growth_delay": 1,
                "polyhydramnios": 1,
                "premature_birth": 1,
                "bilateral_sensorineural_hearing_impairment": 1,
                "family_history_autosomal_recessive": 0,
                "family_history_x_linked": 0
            }
        }
    }
});

hypokalemia => eadv.phen_hypokalemia.val.last();
metabolic_alkalosis => eadv.phen_metabolic_alkalosis.val.last();
renal_salt_wasting => eadv.phen_renal_salt_wasting.val.last();
hypercalciuria => eadv.phen_hypercalciuria.val.last();
nephrocalcinosis => eadv.phen_nephrocalcinosis.val.last();
polyuria => eadv.phen_polyuria.val.last();
polydipsia => eadv.phen_polydipsia.val.last();
growth_delay => eadv.phen_growth_delay.val.last();
polyhydramnios => eadv.phen_polyhydramnios.val.last();
premature_birth => eadv.phen_premature_birth.val.last();
bilateral_sensorineural_hearing_impairment => eadv.phen_bilateral_sensorineural_hearing_impairment.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();
family_history_x_linked => eadv.phen_family_history_x_linked.val.last();

present_feature_count : { . => coalesce(hypokalemia, 0) + coalesce(metabolic_alkalosis, 0) + coalesce(renal_salt_wasting, 0) + coalesce(hypercalciuria, 0) + coalesce(nephrocalcinosis, 0) + coalesce(polyuria, 0) + coalesce(polydipsia, 0) + coalesce(growth_delay, 0) + coalesce(polyhydramnios, 0) + coalesce(premature_birth, 0) + coalesce(bilateral_sensorineural_hearing_impairment, 0) + coalesce(family_history_autosomal_recessive, 0) + coalesce(family_history_x_linked, 0) };
contribution_hypokalemia : { hypokalemia = 1 => 1 }, { => 0 };
contribution_metabolic_alkalosis : { metabolic_alkalosis = 1 => 1 }, { => 0 };
contribution_renal_salt_wasting : { renal_salt_wasting = 1 => 1 }, { => 0 };
contribution_hypercalciuria : { hypercalciuria = 1 => 1 }, { => 0 };
contribution_nephrocalcinosis : { nephrocalcinosis = 1 => 1 }, { => 0 };
contribution_polyuria : { polyuria = 1 => 1 }, { => 0 };
contribution_polydipsia : { polydipsia = 1 => 1 }, { => 0 };
contribution_growth_delay : { growth_delay = 1 => 1 }, { => 0 };
contribution_polyhydramnios : { polyhydramnios = 1 => 1 }, { => 0 };
contribution_premature_birth : { premature_birth = 1 => 1 }, { => 0 };
contribution_bilateral_sensorineural_hearing_impairment : { bilateral_sensorineural_hearing_impairment = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
contribution_family_history_x_linked : { family_history_x_linked = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_hypokalemia + contribution_metabolic_alkalosis + contribution_renal_salt_wasting + contribution_hypercalciuria + contribution_nephrocalcinosis + contribution_polyuria + contribution_polydipsia + contribution_growth_delay + contribution_polyhydramnios + contribution_premature_birth + contribution_bilateral_sensorineural_hearing_impairment + contribution_family_history_autosomal_recessive + contribution_family_history_x_linked };
[[rb_id]] : { . => weighted_score };

#define_attribute(hypokalemia, {
    "label": "Hypokalaemia",
    "atlas": {
        "role": "input",
        "feature_id": "hypokalemia",
        "source_attribute": "phen_hypokalemia",
        "section": "electrolytes_tubular",
        "question": "Has hypokalaemia been documented on blood testing?",
        "answer_type": "presence",
        "hpo_id": "HP:0002900",
        "help": "Use a documented laboratory finding interpreted for age and clinical context. A low or high blood concentration alone does not establish renal wasting or an inherited cause.",
        "source_refs": [
            "erknet_bartter",
            "hpo_terms_2026_09"
        ]
    }
});

#define_attribute(metabolic_alkalosis, {
    "label": "Metabolic alkalosis",
    "atlas": {
        "role": "input",
        "feature_id": "metabolic_alkalosis",
        "source_attribute": "phen_metabolic_alkalosis",
        "section": "electrolytes_tubular",
        "question": "Has metabolic alkalosis been documented?",
        "answer_type": "presence",
        "hpo_id": "HP:0200114",
        "help": "Use a documented acid–base assessment; an isolated bicarbonate result is not sufficient.",
        "source_refs": [
