/* Joubert syndrome: candidate presence count. One point per clinical finding; no diagnostic cutoff. */
#define_ruleblock(ikd_joubert, {
    "description": "Joubert syndrome candidate feature count",
    "is_active": 2,
    "atlas": {
        "schema_version": "1",
        "version": "0.7.0-ciliopathies",
        "disease_label": "Joubert syndrome",
        "disease_id": "ORPHA:140874",
        "source_refs": [
            "genereviews_joubert"
        ],
        "scoring": {
            "model": "ikd-present-count-v1",
            "status": "research",
            "absent_weight": 0,
            "source_refs": [
                "genereviews_joubert"
            ],
            "weights": {
                "molar_tooth_sign": 1,
                "hypotonia": 1,
                "global_developmental_delay": 1,
                "ataxia": 1,
                "oculomotor_apraxia": 1,
                "retinal_dystrophy": 1,
                "renal_cysts": 1,
                "family_history_autosomal_recessive": 0
            }
        }
    }
});

molar_tooth_sign => eadv.phen_molar_tooth_sign.val.last();
hypotonia => eadv.phen_hypotonia.val.last();
global_developmental_delay => eadv.phen_global_developmental_delay.val.last();
ataxia => eadv.phen_ataxia.val.last();
oculomotor_apraxia => eadv.phen_oculomotor_apraxia.val.last();
retinal_dystrophy => eadv.phen_retinal_dystrophy.val.last();
renal_cysts => eadv.phen_renal_cysts.val.last();
family_history_autosomal_recessive => eadv.phen_family_history_autosomal_recessive.val.last();

present_feature_count : { . => coalesce(molar_tooth_sign, 0) + coalesce(hypotonia, 0) + coalesce(global_developmental_delay, 0) + coalesce(ataxia, 0) + coalesce(oculomotor_apraxia, 0) + coalesce(retinal_dystrophy, 0) + coalesce(renal_cysts, 0) + coalesce(family_history_autosomal_recessive, 0) };
contribution_molar_tooth_sign : { molar_tooth_sign = 1 => 1 }, { => 0 };
contribution_hypotonia : { hypotonia = 1 => 1 }, { => 0 };
contribution_global_developmental_delay : { global_developmental_delay = 1 => 1 }, { => 0 };
contribution_ataxia : { ataxia = 1 => 1 }, { => 0 };
contribution_oculomotor_apraxia : { oculomotor_apraxia = 1 => 1 }, { => 0 };
contribution_retinal_dystrophy : { retinal_dystrophy = 1 => 1 }, { => 0 };
contribution_renal_cysts : { renal_cysts = 1 => 1 }, { => 0 };
contribution_family_history_autosomal_recessive : { family_history_autosomal_recessive = 1 => 0 }, { => 0 };
weighted_score : { . => contribution_molar_tooth_sign + contribution_hypotonia + contribution_global_developmental_delay + contribution_ataxia + contribution_oculomotor_apraxia + contribution_retinal_dystrophy + contribution_renal_cysts + contribution_family_history_autosomal_recessive };
[[rb_id]] : { . => weighted_score };

#define_attribute(molar_tooth_sign, {
    "label": "Molar tooth sign on MRI",
    "atlas": {
        "role": "input",
        "feature_id": "molar_tooth_sign",
        "source_attribute": "phen_molar_tooth_sign",
        "section": "neurological_history",
        "question": "Has a molar tooth sign been documented on brain MRI?",
        "answer_type": "presence",
        "hpo_id": "HP:0002419",
        "help": "Use the named radiology finding, not an inferred interpretation of an unrelated MRI.",
        "source_refs": [
            "genereviews_joubert"
        ]
    }
});

#define_attribute(hypotonia, {
    "label": "Hypotonia",
    "atlas": {
