{
  "name": "picorules-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/build-content.ts --check",
    "review:build": "tsx scripts/clinical-review.ts",
    "review:check": "tsx scripts/clinical-review.ts --check",
    "review:gate": "tsx scripts/clinical-review.ts --gate",
    "dev": "npm run content:build && next dev",
    "build": "npm run content:build && next build",
    "preview:lan": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "start": "next start"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "next": "16.3.6",
    "picorules-compiler-js-core": "file:../picorules-compiler-js-core",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^6.12.6",
    "serve": "^14.2.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
